{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Profile",
  "description": "The only place for personal and contact data. Every template reads contact details from here.",
  "type": "object",
  "required": ["name", "position", "affiliation", "email"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "object",
      "required": ["given", "family"],
      "additionalProperties": false,
      "properties": {
        "given": { "type": "string" },
        "middle": { "description": "Middle initial(s), as used in citations.", "type": "string" },
        "family": { "type": "string" },
        "prefix": { "description": "e.g. Dr.", "type": "string" }
      }
    },
    "position": { "$ref": "common.schema.json#/$defs/text" },
    "affiliation": {
      "type": "object",
      "required": ["institution"],
      "additionalProperties": false,
      "properties": {
        "institution": { "$ref": "common.schema.json#/$defs/text" },
        "unit": { "$ref": "common.schema.json#/$defs/text" },
        "url": { "$ref": "common.schema.json#/$defs/url" },
        "city": { "$ref": "common.schema.json#/$defs/text" },
        "country": { "$ref": "common.schema.json#/$defs/country" }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work": { "type": "string", "format": "email" },
        "personal": { "type": "string", "format": "email" },
        "cv": { "description": "Which address the CV shows.", "enum": ["work", "personal"] },
        "website": { "description": "Which address the website shows.", "enum": ["work", "personal"] }
      }
    },
    "phone": { "description": "Office phone, international format.", "type": "string" },
    "website": { "$ref": "common.schema.json#/$defs/url" },
    "orcid": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$" },
    "github": { "type": "string" },
    "osf": { "type": "string" },
    "bluesky": { "type": "string" },
    "linkedin": { "description": "Full profile URL.", "$ref": "common.schema.json#/$defs/url" },
    "twitter": { "type": "string" },
    "extra_links": {
      "description": "Further links shown in the CV header, e.g. a project website.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "url": { "$ref": "common.schema.json#/$defs/url" }
        }
      }
    },
    "research_interests": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
    "research_profile": { "description": "Short paragraph for the CV.", "$ref": "common.schema.json#/$defs/markdown" },
    "bio": { "description": "Website home page text. Markdown, paragraphs allowed.", "type": "string", "minLength": 1 },
    "photo": { "$ref": "common.schema.json#/$defs/path" },
    "social_image": { "$ref": "common.schema.json#/$defs/path" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "items"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "skills_hidden": { "$ref": "common.schema.json#/$defs/hidden" }
  }
}
