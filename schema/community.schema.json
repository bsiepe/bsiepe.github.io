{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community.schema.json",
  "title": "Community service",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["role", "organization", "start", "end"],
    "additionalProperties": false,
    "properties": {
      "role": { "$ref": "common.schema.json#/$defs/text" },
      "organization": { "$ref": "common.schema.json#/$defs/text" },
      "description": { "description": "e.g. refugee aid.", "$ref": "common.schema.json#/$defs/text" },
      "start": { "$ref": "common.schema.json#/$defs/date" },
      "end": { "$ref": "common.schema.json#/$defs/end_date" },
      "hidden": { "$ref": "common.schema.json#/$defs/hidden" },
      "note": { "$ref": "common.schema.json#/$defs/note" }
    }
  }
}
