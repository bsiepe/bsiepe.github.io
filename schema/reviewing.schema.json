{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewing.schema.json",
  "title": "Reviewing",
  "description": "One entry per journal or conference. dates lists each review at the precision known.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["venue", "kind"],
    "additionalProperties": false,
    "properties": {
      "venue": { "description": "Full name, e.g. Multivariate Behavioral Research.", "$ref": "common.schema.json#/$defs/text" },
      "abbreviation": { "type": "string" },
      "kind": { "type": "string", "enum": ["journal", "conference", "preprint-review"] },
      "dates": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/date" } },
      "hidden": { "$ref": "common.schema.json#/$defs/hidden" },
      "note": { "$ref": "common.schema.json#/$defs/note" }
    }
  }
}
