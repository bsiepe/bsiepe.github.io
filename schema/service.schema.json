{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.schema.json",
  "title": "Academic service and editorial positions",
  "description": "Either a period (start, end) or a list of years for recurring roles.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["role", "organization", "kind"],
    "additionalProperties": false,
    "properties": {
      "role": { "$ref": "common.schema.json#/$defs/text" },
      "organization": { "$ref": "common.schema.json#/$defs/text" },
      "kind": { "type": "string", "enum": ["editorial", "committee", "board", "working-group", "organizing", "other"] },
      "start": { "$ref": "common.schema.json#/$defs/date" },
      "end": { "$ref": "common.schema.json#/$defs/end_date" },
      "years": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/date" } },
      "url": { "$ref": "common.schema.json#/$defs/url" },
      "hidden": { "$ref": "common.schema.json#/$defs/hidden" },
      "note": { "$ref": "common.schema.json#/$defs/note" }
    },
    "oneOf": [
      { "required": ["start", "end"], "not": { "required": ["years"] } },
      { "required": ["years"], "not": { "anyOf": [{ "required": ["start"] }, { "required": ["end"] }] } }
    ]
  }
}
