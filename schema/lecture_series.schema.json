{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lecture_series.schema.json",
  "title": "Lecture series",
  "description": "Series metadata and sessions. The .ics calendar file is generated from this.",
  "type": "object",
  "required": ["id", "title", "timezone", "duration_minutes", "sessions"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/text" },
    "about": { "description": "Introductory text for the series page.", "type": "string", "minLength": 1 },
    "schedule": { "description": "Human-readable schedule, e.g. noon on the first Wednesday of each month.", "$ref": "common.schema.json#/$defs/text" },
    "organizer": { "$ref": "common.schema.json#/$defs/text" },
    "contact_email": { "type": "string", "format": "email" },
    "timezone": { "description": "IANA zone, e.g. Europe/Berlin.", "type": "string" },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "time", "speakers", "title"],
        "additionalProperties": false,
        "properties": {
          "date": { "description": "Full date required here.", "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
          "time": { "description": "Local start time, HH:MM.", "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "speakers": { "type": "array", "$ref": "common.schema.json#/$defs/people", "minItems": 1 },
          "title": { "$ref": "common.schema.json#/$defs/text" },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "join":      { "$ref": "common.schema.json#/$defs/url" },
              "slides":    { "$ref": "common.schema.json#/$defs/url" },
              "recording": { "$ref": "common.schema.json#/$defs/url" }
            }
          },
          "hidden": { "$ref": "common.schema.json#/$defs/hidden" },
          "note": { "$ref": "common.schema.json#/$defs/note" }
        }
      }
    }
  }
}
