---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { fullName } from '../lib/format';

type Props = CollectionEntry<'blog'>['data'] & { headings?: { depth: number; slug: string; text: string }[] };

const { title, description = '', date, updated, image, authors, headings = [] } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post-head { max-width: 66ch; margin-bottom: var(--s6); }
			.post-head h1 { margin-bottom: var(--s1); }
			.post-meta { margin: 0; font-size: 15px; color: var(--color-text-muted); }
			.post-meta time { font-family: var(--font-serif); font-size: 17px; font-variant-numeric: lining-nums tabular-nums; }
			.hero-image { margin: 0 0 var(--s6); max-width: 66ch; }
			.hero-image img { display: block; width: 100%; height: auto; }

			/* Text column with the table of contents to its right on wide screens */
			.post-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
			@media (min-width: 1100px) {
				.post-grid { grid-template-columns: minmax(0, 66ch) 240px; column-gap: var(--s8); justify-content: space-between; }
			}
			.prose { min-width: 0; max-width: 66ch; }

			.prose :global(h2) { font-size: 26px; margin: var(--s6) 0 var(--s2); }
			.prose :global(h3) { font-size: 21px; margin: var(--s4) 0 var(--s1); }
			.prose :global(ul),
			.prose :global(ol) { margin: 0 0 1em; padding-left: 1.5rem; }
			.prose :global(li) { margin: 0.35rem 0; }
			.prose :global(li > p) { margin-bottom: 0.5rem; }
			.prose :global(blockquote) { margin: var(--s4) 0; padding: var(--s2) var(--s3); background: var(--color-step); color: var(--color-text-2); }
			.prose :global(blockquote p:last-child) { margin-bottom: 0; }
			.prose :global(blockquote cite) { display: block; margin-top: var(--s1); font-style: normal; font-size: 15px; color: var(--color-text-muted); }
			.prose :global(hr) { height: var(--s4); margin: var(--s4) 0; border: 0; }
			.prose :global(img) { display: block; max-width: 100%; height: auto; }
			.prose :global(details) { margin: var(--s3) 0; padding: var(--s2) var(--s3); background: var(--color-step); }
			.prose :global(summary) { cursor: pointer; font-weight: 700; }
			.prose :global(input[type='checkbox']) { margin-right: 0.6rem; accent-color: var(--color-accent); }
			.prose :global(section[data-footnotes]) { margin-top: var(--s6); font-size: 15px; }

			/* Tables keep their lines; they are real tables. */
			.prose :global(table) { width: 100%; margin: var(--s4) 0; border-collapse: collapse; display: block; overflow-x: auto; font-size: 15px; }
			.prose :global(th),
			.prose :global(td) { padding: 8px 12px; border-bottom: 1px solid var(--color-border); text-align: left; }
			.prose :global(th) { font-weight: 700; }

			/* Code: inline on a tone step; blocks as one flat panel with a small header row */
			.prose :global(code) {
				font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace;
				font-size: 0.88em;
				background: var(--color-step);
				padding: 0.1em 0.3em;
				border-radius: 2px;
			}
			.prose :global(.code-block-frame) {
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-areas: "label copy" "code code";
				margin: var(--s4) 0;
				background: var(--color-step);
			}
			.prose :global(.code-block-label) {
				grid-area: label;
				align-self: center;
				padding: 8px var(--s3) 0;
				font-size: 15px;
				color: var(--color-text-muted);
			}
			.prose :global(.copy-code-button) {
				grid-area: copy;
				margin: 4px 8px 0 0;
				padding: 4px 12px;
				border: 0;
				background: none;
				font: inherit;
				font-size: 15px;
				color: var(--color-accent);
				cursor: pointer;
			}
			.prose :global(.copy-code-button:hover) { text-decoration: underline; }
			.prose :global(.copy-code-button__success) { display: none; }
			.prose :global(.copy-code-button[data-copied='true'] .copy-code-button__default) { display: none; }
			.prose :global(.copy-code-button[data-copied='true'] .copy-code-button__success) { display: inline; }
			.prose :global(pre) { margin: var(--s4) 0; overflow-x: auto; }
			.prose :global(.code-block-frame pre) { grid-area: code; margin: 0; }
			.prose :global(pre.astro-code) {
				padding: 12px var(--s3) var(--s2) !important;
				background-color: var(--color-step) !important;
				border: 0;
				border-radius: 0;
			}
			.prose :global(pre code) {
				display: block;
				min-width: max-content;
				background: transparent;
				padding: 0;
				border-radius: 0;
				font-size: 14px;
				line-height: 1.6;
			}
			.prose :global(pre.astro-code .line) { display: inline-block; }
			html[data-theme='dark'] .prose :global(pre.astro-code span) {
				color: var(--shiki-dark) !important;
				font-style: var(--shiki-dark-font-style) !important;
				font-weight: var(--shiki-dark-font-weight) !important;
				text-decoration: var(--shiki-dark-text-decoration) !important;
			}
			.prose :global(pre.astro-code span) { background-color: transparent !important; }

			/* Callouts: a tone step and a plain label */
			.prose :global(.callout) { margin: var(--s4) 0; padding: var(--s2) var(--s3); background: var(--color-step); }
			.prose :global(.callout::before) { content: attr(data-callout); display: block; margin-bottom: 4px; font-weight: 700; text-transform: capitalize; }
			.prose :global(.callout p:last-child) { margin-bottom: 0; }

			@media (max-width: 560px) {
				.prose :global(h2) { font-size: 22px; }
				.prose :global(.code-block-label) { padding-left: var(--s2); }
				.prose :global(pre.astro-code) { padding: 12px var(--s2) var(--s2) !important; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main data-pagefind-body>
			<article>
				<header class="post-head">
					<h1>{title}</h1>
					<p class="post-meta">
						<FormattedDate date={date} />
						{authors && authors.length > 0 && <> · {authors.map(fullName).join(', ')}</>}
						{updated && <> · updated <FormattedDate date={updated} /></>}
					</p>
				</header>
				{image && (
					<div class="hero-image">
						<Image width={1020} height={510} src={image} alt="" />
					</div>
				)}
				<div class="post-grid">
					<div class="prose">
						{headings.length > 0 && <TableOfContents headings={headings} mobile={true} />}
						<slot />
					</div>
					{headings.length > 0 && <TableOfContents headings={headings} mobile={false} />}
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline data-astro-rerun>
			function getCodeBlockLabel(pre) {
				const explicitLabel =
					pre.getAttribute('data-file') ||
					pre.getAttribute('data-filename') ||
					pre.dataset.file ||
					pre.dataset.filename;
				if (explicitLabel) return explicitLabel;

				const code = pre.querySelector('code');
				const languageClass = code
					? Array.from(code.classList).find((className) => className.startsWith('language-'))
					: null;
				const language =
					pre.getAttribute('data-language') ||
					pre.dataset.language ||
					(languageClass ? languageClass.replace('language-', '') : '');
				const normalized = language.toLowerCase();

				const labels = {
					astro: 'Astro',
					bash: 'Bash',
					css: 'CSS',
					diff: 'Diff',
					html: 'HTML',
					js: 'JavaScript',
					json: 'JSON',
					md: 'Markdown',
					plaintext: 'Code',
					sh: 'Shell',
					shell: 'Shell',
					text: 'Code',
					toml: 'TOML',
					ts: 'TypeScript',
					tsx: 'TSX',
					yaml: 'YAML',
					yml: 'YAML',
				};

				if (!normalized) return 'Code';
				return labels[normalized] || normalized.toUpperCase();
			}

			async function writeToClipboard(text) {
				if (navigator.clipboard && navigator.clipboard.writeText) {
					await navigator.clipboard.writeText(text);
					return;
				}

				const textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.setAttribute('readonly', 'true');
				textarea.style.position = 'absolute';
				textarea.style.left = '-9999px';
				document.body.appendChild(textarea);
				textarea.select();
				document.execCommand('copy');
				document.body.removeChild(textarea);
			}

			function enhanceCodeBlocks() {
				const codeBlocks = Array.from(document.querySelectorAll('.prose pre'));

				for (const pre of codeBlocks) {
					if (pre.dataset.enhancedCodeBlock === 'true') continue;

					const code = pre.querySelector('code');
					if (!code) continue;

					pre.dataset.enhancedCodeBlock = 'true';
					pre.setAttribute('tabindex', '0');

					const wrapper = document.createElement('div');
					wrapper.className = 'code-block-frame';

					pre.parentNode?.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);

					const label = document.createElement('span');
					label.className = 'code-block-label';
					label.textContent = getCodeBlockLabel(pre);

					const copyButton = document.createElement('button');
					copyButton.type = 'button';
					copyButton.className = 'copy-code-button';
					copyButton.innerHTML =
						'<span class="copy-code-button__default">Copy</span><span class="copy-code-button__success">Copied</span>';
					copyButton.setAttribute('aria-label', `Copy ${label.textContent} code`);

					copyButton.addEventListener('click', async () => {
						try {
							await writeToClipboard(code.innerText || '');
							copyButton.dataset.copied = 'true';
							window.setTimeout(() => {
								copyButton.dataset.copied = 'false';
							}, 1200);
						} catch (error) {
							console.error('Failed to copy code block', error);
						}
					});

					wrapper.appendChild(label);
					wrapper.appendChild(copyButton);
				}
			}

			enhanceCodeBlocks();

			if (!window.__academicPortfolioCodeBlockListener) {
				document.addEventListener('astro:after-swap', enhanceCodeBlocks);
				window.__academicPortfolioCodeBlockListener = true;
			}
		</script>
	</body>
</html>
