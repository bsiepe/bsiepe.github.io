---
// Talk thumbnail from scripts/thumbnails.mjs, or a plain title card when the
// talk has no PDF (HTML slides or no slides).
import fs from 'node:fs';
import path from 'node:path';
import { url } from '../utils/paths';

interface Props { id: string; title: string; href: string }
const { id, title, href } = Astro.props;

const dir = path.join(process.cwd(), 'public', 'thumbnails', 'talks');
const file = ['.png', '.jpg', '.jpeg', '.webp'].map((e) => id + e).find((f) => fs.existsSync(path.join(dir, f)));
---

<a class="thumb" href={href} tabindex="-1" aria-hidden="true">
	{file ? (
		<img src={url(`/thumbnails/talks/${file}`)} alt="" loading="lazy" decoding="async" />
	) : (
		<span class="card">{title}</span>
	)}
</a>

<style>
	.thumb {
		display: block;
		width: 12rem;
		aspect-ratio: 16 / 9;
		flex-shrink: 0;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		background: var(--color-bg);
	}
	.thumb:hover { opacity: 1; text-decoration: none; border-color: var(--color-text-muted); }
	img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
	.card {
		display: flex;
		align-items: center;
		height: 100%;
		padding: 0.6rem 0.75rem;
		font-family: var(--font-serif);
		font-size: 0.85rem;
		line-height: 1.25;
		color: var(--color-text-main);
		overflow: hidden;
	}
	@media (max-width: 720px) {
		.thumb { width: 100%; max-width: 24rem; }
		.card { font-size: 1.1rem; padding: 1rem; }
	}
</style>
