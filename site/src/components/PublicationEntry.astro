---
// One publication: year in the margin column, then authors, title, venue, materials, areas, abstract.
// repeatYear hides the year when the entry above has the same one.
import Areas from './Areas.astro';
import type { Publication } from '../lib/data';
import { artifactSlots, extraLinks, shortName, shownAuthors, venueParts } from '../lib/format';
import { md } from '../lib/markdown';

interface Props { pub: Publication; abstract?: boolean; repeatYear?: boolean }
const { pub: p, abstract = true, repeatYear = false } = Astro.props;

const sf = p.shared_first ?? [];
const ss = p.shared_second ?? [];
const { venue, rest } = venueParts(p);
const slots = artifactSlots(p).filter((s) => s.href);
const extras = extraLinks(p);
const abstractHtml = abstract && p.abstract ? await md(p.abstract) : '';
const shown = shownAuthors(p.authors);
// Separator before item k: ", & " before the last named author, ", " otherwise.
const sep = (k: number) => (k === 0 ? '' : shown[k] === null ? ', ' : k === shown.length - 1 && shown[k - 1] !== null ? ', & ' : ', ');
---

<article class="pub" id={p.id} data-areas={(p.areas ?? []).join(' ')}>
	<span class={repeatYear ? 'pub-year repeat' : 'pub-year'}>{p.year}</span>
	<div class="pub-body">
		<p class="pub-authors">
			{/* One line per author on purpose: line breaks between these expressions would render as spaces. */}
			{shown.map((i, k) => (
				<>{sep(k)}{i === null ? '…' : <>{p.authors[i].me ? <strong>{shortName(p.authors[i])}</strong> : shortName(p.authors[i])}{sf.includes(i + 1) && <sup>†</sup>}{ss.includes(i + 1) && <sup>‡</sup>}</>}</>
			))}
		</p>
		<h3 class="pub-title">{p.title}</h3>
		<p class="pub-venue">
			{venue && <em>{venue}</em>}{venue && rest ? ', ' : ''}{rest}
		</p>
		<div class="pub-meta">
			<ul class="slots" aria-label="Materials">
				{slots.map((s) => (
					<li><a href={s.href}>{s.label}</a></li>
				))}
				{extras.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
			</ul>
			<Areas areas={p.areas} />
		</div>
		{abstractHtml && (
			<details class="pub-abstract">
				<summary>Abstract</summary>
				<div set:html={abstractHtml} />
			</details>
		)}
	</div>
</article>
