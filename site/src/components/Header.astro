---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
---

<header class="site-header">
	<div class="header-row">
		<a class="wordmark" href={url('/')}>{SITE_TITLE}</a>
		<nav aria-label="Main">
			<HeaderLink href={url('/publications')}>Publications</HeaderLink>
			<HeaderLink href={url('/talks')}>Talks</HeaderLink>
			<HeaderLink href={url('/workshops')}>Workshops</HeaderLink>
			<HeaderLink href={url('/software')}>Software</HeaderLink>
			<HeaderLink href={url('/blog')}>Blog</HeaderLink>
			<HeaderLink href={url('/cv')}>CV</HeaderLink>
		</nav>
		<div class="header-actions">
			<button type="button" class="icon-btn search-toggle" aria-label="Search site">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
			</button>
			<button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode">
				<svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
				<svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
			</button>
		</div>
	</div>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		const newTheme = isDark ? 'light' : 'dark';
		(window as any).__setPreferredTheme?.(newTheme);
		localStorage.setItem('theme', newTheme);
	});

	document.querySelectorAll('.search-toggle').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.dispatchEvent(new CustomEvent('open-search'));
		});
	});
</script>

<style>
	.site-header { padding: var(--s3) var(--frame) 0; }
	.header-row {
		display: flex;
		align-items: center;
		gap: var(--s4);
		max-width: var(--max-width);
		margin: 0 auto;
	}
	.wordmark {
		font-family: var(--font-serif);
		font-size: 21px;
		font-weight: 500;
		color: var(--color-text-main);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 4px var(--s3);
		margin-left: auto;
		font-size: 15px;
	}
	nav :global(a) { color: var(--color-text-main); text-decoration: none; }
	nav :global(a:hover) { color: var(--color-accent); }
	nav :global(a.active) {
		font-weight: inherit;
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}
	.header-actions { display: flex; gap: var(--s1); }
	.icon-btn {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text-main);
		cursor: pointer;
	}
	.icon-btn:hover { color: var(--color-accent); }

	/* The icon shows the theme you switch to. */
	.sun-icon { display: none; }
	:global(html[data-theme='dark']) .sun-icon { display: block; }
	:global(html[data-theme='dark']) .moon-icon { display: none; }

	@media (max-width: 680px) {
		.header-row { flex-wrap: wrap; justify-content: space-between; row-gap: var(--s1); }
		nav { order: 3; width: 100%; margin-left: 0; }
	}
</style>
