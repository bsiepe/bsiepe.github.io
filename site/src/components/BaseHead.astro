---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { GOATCOUNTER_ENDPOINT, PROFILE, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

interface Props {
	title: string;
	description: string;
	image?: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Social preview image: the photo from profile.yml (copied into public/ by scripts/sync-assets.mjs).
const defaultImg = `/${PROFILE.social_image}`;

const { title, description, image = defaultImg } = Astro.props;
// Self-hosted fonts (OFL 1.1, public/fonts/licenses/): latin and latin-ext subsets.
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const FACES: [family: string, file: string, weight: number, style: string][] = [
	['Atkinson Hyperlegible', 'atkinson-hyperlegible', 400, 'normal'],
	['Atkinson Hyperlegible', 'atkinson-hyperlegible', 400, 'italic'],
	['Atkinson Hyperlegible', 'atkinson-hyperlegible', 700, 'normal'],
	['Crimson Pro', 'crimson-pro', 400, 'normal'],
	['Crimson Pro', 'crimson-pro', 500, 'normal'],
	['Crimson Pro', 'crimson-pro', 600, 'normal'],
];
const fontFaces = FACES.flatMap(([family, file, weight, style]) =>
	[['latin', LATIN], ['latin-ext', LATIN_EXT]].map(([subset, range]) =>
		`@font-face { font-family: "${family}"; src: url("${url(`/fonts/${file}-${subset}-${weight}-${style}.woff2`)}") format("woff2"); font-weight: ${weight}; font-style: ${style}; font-display: swap; unicode-range: ${range}; }`,
	),
).join('\n');

const resolveImage = (img: string) => {
    if (img.startsWith('http')) return img;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
    if (img.startsWith(base)) return img;
    return `${base}${img.replace(/^\//, '')}`;
};

const imageUrl = typeof image === 'string'
	? new URL(resolveImage(image), Astro.url)
	: new URL(image.src, Astro.url);
---

<meta charset="utf-8" />
<script is:inline data-cfasync="false">
	(() => {
		const root = document.documentElement;
		const paintTheme = (theme) => {
			const dark = theme === 'dark';
			root.setAttribute('data-theme', dark ? 'dark' : 'light');
			root.style.setProperty('background-color', 'var(--color-bg)');
			root.style.colorScheme = dark ? 'dark' : 'light';
		};
		let theme = 'light';
		try {
			const s = localStorage.getItem('theme');
			if (s === 'dark' || s === 'light') theme = s;
			else if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
		} catch {
			if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
		}
		paintTheme(theme);
		window.addEventListener('load', () => root.setAttribute('data-theme-ready', 'true'), { once: true });
		window.__setPreferredTheme = paintTheme;
	})();
</script>
<style is:inline>
	/* CSS variables inline — available immediately in all modes (dev + prod), before any external CSS */
	:root {
		--color-bg: #ffffff;
		--color-text-main: #1b1c1e;
		--color-text-muted: #56595e;
		--color-accent: #0047ab;
	}
	[data-theme='dark'] {
		--color-bg: #131518;
		--color-text-main: #e6e7e9;
		--color-text-muted: #a2a6ab;
		--color-accent: #8db1ff;
	}
	html, body { min-height: 100%; background-color: var(--color-bg); }
	@media (prefers-color-scheme: dark) {
		html:not([data-theme='light']), html:not([data-theme='light']) body { background-color: var(--color-bg); }
	}
	html[data-theme='dark'], html[data-theme='dark'] body { background-color: var(--color-bg); color-scheme: dark; }
	html[data-theme='light'], html[data-theme='light'] body { background-color: var(--color-bg); color-scheme: light; }
	body {
		background-color: var(--color-bg);
		color: var(--color-text-main);
		margin: 0;
	}
	/* Suppress all transitions until page is fully styled */
	html:not([data-theme-ready]) *, html:not([data-theme-ready]) *::before, html:not([data-theme-ready]) *::after {
		transition: none !important;
		animation: none !important;
	}
</style>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />

<style is:inline set:html={fontFaces} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />

{import.meta.env.PROD && (
	<script is:inline async src={url('/js/count.js')} data-goatcounter={GOATCOUNTER_ENDPOINT}></script>
)}
