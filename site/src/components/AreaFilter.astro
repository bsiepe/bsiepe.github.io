---
// Filter by research area. Entries carry data-areas="a b"; sections whose
// entries are all hidden are hidden too. The choice is kept in ?area=<key> so a
// filtered view can be linked. Without JavaScript the buttons stay hidden and
// everything is shown.
import { AREA_LABELS } from '../lib/format';

interface Props { counts: Record<string, number> }
const { counts } = Astro.props;
const areas = Object.keys(AREA_LABELS).filter((a) => counts[a]);
---

<div class="area-filter" role="group" aria-label="Filter by research area" hidden>
	<button type="button" data-area="" aria-pressed="true">All</button>
	{areas.map((a) => (
		<button type="button" data-area={a} aria-pressed="false" class={`area-${a}`}>
			{AREA_LABELS[a]} <span class="count">{counts[a]}</span>
		</button>
	))}
</div>

<style>
	.area-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; }
	.area-filter[hidden] { display: none; }
	button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-accent);
		border-radius: 4px;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
	}
	button[data-area=''] { border-left-color: var(--color-border); }
	button.area-timeseries { border-left-color: #2a9d8f; }
	button.area-esm { border-left-color: #c77d2a; }
	button[aria-pressed='true'] { color: var(--color-text-main); border-color: var(--color-text-muted); font-weight: 700; }
	.count { color: var(--color-text-muted); font-weight: 400; }
</style>

<script>
	const bar = document.querySelector<HTMLElement>('.area-filter');
	if (bar) {
		const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
		const entries = [...document.querySelectorAll<HTMLElement>('[data-areas]')];
		const sections = [...document.querySelectorAll<HTMLElement>('[data-filter-section]')];

		const apply = (area: string) => {
			if (!buttons.some((b) => b.dataset.area === area)) area = '';
			for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.area === area));
			for (const e of entries) e.hidden = !!area && !e.dataset.areas!.split(' ').includes(area);
			for (const s of sections) s.hidden = !s.querySelector('[data-areas]:not([hidden])');
			const u = new URL(location.href);
			if (area) u.searchParams.set('area', area);
			else u.searchParams.delete('area');
			history.replaceState(null, '', u);
		};

		bar.addEventListener('click', (ev) => {
			const b = (ev.target as HTMLElement).closest('button');
			if (b) apply(b.dataset.area ?? '');
		});
		bar.hidden = false;
		apply(new URL(location.href).searchParams.get('area') ?? '');
	}
</script>
