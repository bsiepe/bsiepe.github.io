---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import Search from './Search.astro';
import { url } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-content">
		<div>&copy; {year} {SITE_TITLE}</div>
		<nav class="footer-links" aria-label="Contact and profiles">
			{SOCIAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
			<a href={url('/impressum/')}>Impressum</a>
		</nav>
	</div>
	<div class="footer-credit">
		Built with <a href="https://astro.build">Astro</a> on the
		<a href="https://github.com/shravanngoswamii/astro-scholar">astro-scholar</a> theme.
		<a href="https://github.com/bsiepe/bsiepe.github.io">Source</a>
	</div>
</footer>

<Search />

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 4rem;
		padding: 2rem 1rem;
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}
	.footer-content,
	.footer-credit {
		max-width: var(--max-width);
		margin: 0 auto;
	}
	.footer-content {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}
	.footer-credit {
		margin-top: 1rem;
		font-size: 0.8rem;
	}
</style>
