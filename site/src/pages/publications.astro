---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AreaFilter from '../components/AreaFilter.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { SITE_TITLE } from '../consts';
import { publications } from '../lib/data';
import { url } from '../utils/paths';

const pubs = publications().sort((a, b) => b.year - a.year);
const groups = [
	{ title: 'Peer-reviewed articles', items: pubs.filter((p) => p.type === 'article') },
	{ title: 'Preprints', items: pubs.filter((p) => p.type === 'preprint') },
	{ title: 'Book chapters', items: pubs.filter((p) => p.type === 'chapter') },
	{ title: 'Reports', items: pubs.filter((p) => p.type === 'report') },
].filter((g) => g.items.length > 0);
const counts: Record<string, number> = {};
for (const p of pubs) for (const a of p.areas ?? []) counts[a] = (counts[a] ?? 0) + 1;
const shared = pubs.some((p) => p.shared_first || p.shared_second);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Publications | ${SITE_TITLE}`} description={`Publications by ${SITE_TITLE}`} />
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<h1>Publications</h1>
			<p class="lead">
				Each paper links to the materials that exist, always in the same order: paper,
				preprint, code, data, materials, and preregistration.
				{shared && <> <sup>†</sup> shared first authorship, <sup>‡</sup> shared second authorship.</>}
				All entries as <a href={url('/publications.bib')}>BibTeX</a> or <a href={url('/publications.json')}>CSL-JSON</a>.
			</p>
			<AreaFilter counts={counts} />
			{groups.map((g) => (
				<section data-filter-section>
					<h2>{g.title}</h2>
					<div class="pub-list">
						{g.items.map((p, k) => <PublicationEntry pub={p} repeatYear={k > 0 && g.items[k - 1].year === p.year} />)}
					</div>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
