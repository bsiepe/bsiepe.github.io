---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { fullName } from '../../lib/format';
import { url } from '../../utils/paths';

export async function getStaticPaths() {
    const posts = (await getCollection('blog'))
        .filter((p) => !p.data.draft)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    const pageSize = 4;
    const totalPages = Math.ceil(posts.length / pageSize);
    const paths = [];

    for (let i = 1; i <= totalPages; i++) {
        paths.push({
            params: { page: i === 1 ? undefined : String(i) },
            props: {
                posts: posts.slice((i - 1) * pageSize, i * pageSize),
                currentPage: i,
                totalPages,
                nextPage: i < totalPages ? i + 1 : null,
                prevPage: i > 1 ? i - 1 : null,
            },
        });
    }

    return paths;
}

const { posts, currentPage, totalPages, nextPage, prevPage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.post-list { display: grid; gap: var(--s6); }
			.post { display: grid; grid-template-columns: minmax(0, 66ch) 240px; column-gap: var(--s8); justify-content: space-between; align-items: start; }
			.post h2 { font-size: 21px; font-weight: 600; line-height: 1.3; margin: 0; }
			.post h2 a { color: var(--color-text-main); text-decoration: none; }
			.post h2 a:hover { color: var(--color-accent); text-decoration: underline; }
			.post-meta { margin: 4px 0 0; font-size: 15px; color: var(--color-text-muted); }
			.post-meta time { font-family: var(--font-serif); font-size: 17px; font-variant-numeric: lining-nums tabular-nums; }
			.post-desc { margin: var(--s1) 0 0; }
			.post-image { display: block; background: var(--color-step); }
			.post-image img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
			.pager { display: flex; gap: var(--s3); margin-top: var(--s6); font-size: 15px; color: var(--color-text-muted); }
			@media (max-width: 720px) {
				.post { grid-template-columns: minmax(0, 1fr); row-gap: var(--s2); }
				.post-image { order: -1; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<h1>Blog</h1>
			<div class="post-list">
				{posts.map((post) => (
					<article class="post">
						<div>
							<h2><a href={url(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
							<p class="post-meta"><FormattedDate date={post.data.date} /> · {post.data.authors.map(fullName).join(', ')}</p>
							{post.data.description && <p class="post-desc">{post.data.description}</p>}
						</div>
						{post.data.image && (
							<a href={url(`/blog/${post.id}/`)} class="post-image" tabindex="-1" aria-hidden="true">
								<Image width={480} height={270} src={post.data.image} alt="" />
							</a>
						)}
					</article>
				))}
				{posts.length === 0 && <p>No posts yet.</p>}
			</div>
			{totalPages > 1 && (
				<nav class="pager" aria-label="Pages">
					{prevPage && <a href={url(prevPage === 1 ? '/blog/' : `/blog/${prevPage}/`)}>Newer posts</a>}
					<span>Page {currentPage} of {totalPages}</span>
					{nextPage && <a href={url(`/blog/${nextPage}/`)}>Older posts</a>}
				</nav>
			)}
		</main>
		<Footer />
	</body>
</html>
