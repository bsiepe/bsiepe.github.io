---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { workshops, type WorkshopSession } from '../lib/data';
import { AREA_LABELS, formatDate, fullName, noteOf, place, urlOf } from '../lib/format';
import { md } from '../lib/markdown';
import { url } from '../utils/paths';

// One entry per workshop, sorted by its most recent session. Each has an anchor
// (#id) so that the old per-workshop pages can redirect here.
const all = await Promise.all(
	workshops().map(async (w) => ({ ...w, html: w.description ? await md(w.description) : '' })),
);

const LINK_LABELS: Record<string, string> = { materials: 'Materials', repo: 'Repository', osf: 'OSF', zenodo: 'Zenodo' };
const hours = (h?: number) => (h ? `${h} ${h === 1 ? 'hour' : 'hours'}` : '');
const where = (s: WorkshopSession) => [s.host, place(s)].filter(Boolean).join(', ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Workshops | ${SITE_TITLE}`} description={`Workshops taught by ${SITE_TITLE}`} />
		<style>
			.sessions { list-style: none; padding: 0; margin: 0.5rem 0 0; font-size: 0.95rem; }
			.sessions li {
				display: grid;
				grid-template-columns: 8rem 1fr auto;
				gap: 1rem;
				padding: 0.3rem 0;
				align-items: baseline;
			}
			.sessions time { color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
			.session-meta { display: block; font-size: 0.9rem; color: var(--color-text-muted); }
			.item-desc :global(p) { margin: 0.25rem 0 0; }
			@media (max-width: 720px) {
				.sessions li { grid-template-columns: 1fr; gap: 0.1rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<h1>Workshops</h1>
			{all.map((w) => (
				<article class="item" id={w.id}>
					<h3 class="item-title">{w.title}</h3>
					{w.html && <div class="item-desc" set:html={w.html} />}
					{w.areas && w.areas.length > 0 && (
						<ul class="areas">{w.areas.map((a) => <li class={`area area-${a}`}>{AREA_LABELS[a] ?? a}</li>)}</ul>
					)}
					{w.links && (
						<ul class="slots">
							{Object.entries(w.links).map(([k, v]) => <li><a href={urlOf(v)}>{noteOf(v) ?? LINK_LABELS[k] ?? k}</a></li>)}
						</ul>
					)}
					<ul class="sessions">
						{w.sessions.map((s) => (
							<li>
								<time datetime={s.date}>{formatDate(s.date)}</time>
								<span>
									{s.title && s.title !== w.title && <em>{s.title}. </em>}
									{where(s)}
									{(s.duration_hours || s.format || s.coinstructors?.length) && (
										<span class="session-meta">
											{[s.format, hours(s.duration_hours), s.coinstructors?.length ? `with ${s.coinstructors.map(fullName).join(', ')}` : '']
												.filter(Boolean)
												.join(' · ')}
										</span>
									)}
								</span>
								<span>{s.file && <a href={url(`/${s.file}`)}>Slides</a>}</span>
							</li>
						))}
					</ul>
					{w.license && <p class="item-meta">Materials licensed under {w.license.replace(/-/g, ' ')}.</p>}
				</article>
			))}
		</main>
		<Footer />
	</body>
</html>
