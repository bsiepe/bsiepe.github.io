---
import Areas from '../components/Areas.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { workshops, type WorkshopSession } from '../lib/data';
import { formatDate, fullName, noteOf, place, urlOf } from '../lib/format';
import { md } from '../lib/markdown';
import { url } from '../utils/paths';

// One entry per workshop, sorted by its most recent session. Each has an anchor
// (#id) so that the old per-workshop pages can redirect here.
const all = await Promise.all(
	workshops().map(async (w) => ({ ...w, html: w.description ? await md(w.description) : '' })),
);

const LINK_LABELS: Record<string, string> = { materials: 'Materials', repo: 'Repository', osf: 'OSF', zenodo: 'Zenodo' };
const hours = (h?: number) => (h ? `${h} ${h === 1 ? 'hour' : 'hours'}` : '');
const where = (s: WorkshopSession) => [s.host, place(s)].filter(Boolean).join(', ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Workshops | ${SITE_TITLE}`} description={`Workshops taught by ${SITE_TITLE}`} />
		<style>
			.workshop { margin-bottom: var(--s8); }
			.workshop .areas { margin-top: var(--s1); }
			.item-desc :global(p) { margin: 4px 0 0; }
			.sessions { list-style: none; padding: 0; margin: var(--s3) 0 0; display: grid; gap: var(--s2); }
			.sessions > li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: var(--s3); }
			.sessions time { font-family: var(--font-serif); font-size: 17px; line-height: 1.5; color: var(--color-text-muted); font-variant-numeric: lining-nums tabular-nums; }
			.session-where { margin: 0; }
			.session-meta { margin: 0; font-size: 15px; color: var(--color-text-muted); }
			.sessions .slots { margin-top: 2px; }
			.license { margin-top: var(--s2); font-size: 15px; color: var(--color-text-muted); }
			@media (max-width: 560px) {
				.sessions > li { grid-template-columns: 1fr; }
				.sessions time { font-size: 15px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<h1>Workshops</h1>
			{all.map((w) => {
				// The workshop's own links appear with every session, after that session's slides.
				const shared = Object.entries(w.links ?? {}).map(([k, v]) => ({ label: noteOf(v) ?? LINK_LABELS[k] ?? k, href: urlOf(v) }));
				return (
					<article class="workshop" id={w.id}>
						<h3 class="item-title">{w.title}</h3>
						{w.html && <div class="item-desc" set:html={w.html} />}
						<Areas areas={w.areas} />
						<ul class="sessions">
							{w.sessions.map((s) => {
								const links = [...(s.file ? [{ label: 'Slides', href: url(`/${s.file}`) }] : []), ...shared];
								const meta = [s.format, hours(s.duration_hours), s.coinstructors?.length ? `with ${s.coinstructors.map(fullName).join(', ')}` : '']
									.filter(Boolean)
									.join(' · ');
								return (
									<li>
										<time datetime={s.date}>{formatDate(s.date)}</time>
										<div>
											<p class="session-where">{s.title && s.title !== w.title && <em>{s.title}. </em>}{where(s)}</p>
											{meta && <p class="session-meta">{meta}</p>}
											{links.length > 0 && (
												<ul class="slots" aria-label="Materials">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
											)}
										</div>
									</li>
								);
							})}
						</ul>
						{w.license && <p class="license">Materials licensed under {w.license.replace(/-/g, ' ')}.</p>}
					</article>
				);
			})}
		</main>
		<Footer />
	</body>
</html>
