---
// CV page: a download link and, on wider screens, the PDF inline in the browser's
// own viewer (the file is served from this site, no third party). The PDF keeps
// its old URL, /cv/cv_siepe.pdf; it is built by `npm run cv` in the repo root.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CV_URL, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`CV | ${SITE_TITLE}`} description={`Curriculum vitae of ${SITE_TITLE}`} />
		<style>
			.cv-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); margin-bottom: var(--s4); }
			.cv-actions p { margin: 0; font-size: 15px; color: var(--color-text-muted); }
			.cv-viewer { display: block; width: 100%; height: max(640px, calc(100vh - 120px)); border: 0; background: var(--color-step); }
			@media (max-width: 720px) {
				.cv-viewer { display: none; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<h1>CV</h1>
			<div class="cv-actions">
				<a class="btn" href={url(CV_URL)}>Download CV (PDF)</a>
				<p>
					Publications are also available as <a href={url('/publications.bib')}>BibTeX</a> and
					<a href={url('/publications.json')}>CSL-JSON</a>.
				</p>
			</div>
			<object class="cv-viewer" data={`${url(CV_URL)}#view=FitH`} type="application/pdf" aria-label="CV (PDF)">
				<p><a href={url(CV_URL)}>Open the CV as PDF</a></p>
			</object>
		</main>
		<Footer />
	</body>
</html>
