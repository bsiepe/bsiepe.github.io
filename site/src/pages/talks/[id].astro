---
import Areas from '../../components/Areas.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PublicationEntry from '../../components/PublicationEntry.astro';
import { SITE_TITLE } from '../../consts';
import { publications, talks, type Talk } from '../../lib/data';
import { TALK_TYPES, formatDate, fullName, place, urlOf } from '../../lib/format';
import { md } from '../../lib/markdown';
import { url } from '../../utils/paths';

export function getStaticPaths() {
	return talks().map((t) => ({ params: { id: t.id }, props: { talk: t } }));
}

const { talk: t } = Astro.props as { talk: Talk };
const related = publications().filter((p) => t.publications?.includes(p.id));
const abstract = t.abstract ? await md(t.abstract) : '';
const roleNote = (roles: string[]) =>
	roles.includes('speaker') ? '' : roles.map((r) => r.charAt(0).toUpperCase() + r.slice(1)).join(', ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${t.title} | ${SITE_TITLE}`} description={`Talk by ${SITE_TITLE}: ${t.title}`} />
		<style>
			.talk-areas { margin-bottom: var(--s3); }
			.events { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s2); }
			.events > li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: var(--s3); }
			.events time { font-family: var(--font-serif); font-size: 17px; line-height: 1.5; color: var(--color-text-muted); font-variant-numeric: lining-nums tabular-nums; }
			.events p { margin: 0; }
			.event-title { font-style: italic; color: var(--color-text-muted); }
			.event-meta { font-size: 15px; color: var(--color-text-muted); }
			.events .slots { margin-top: 2px; }
			.license { margin-top: var(--s6); font-size: 15px; color: var(--color-text-muted); }
			@media (max-width: 560px) {
				.events > li { grid-template-columns: 1fr; }
				.events time { font-size: 15px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<p><a href={url('/talks/')}>All talks</a></p>
			<h1>{t.title}</h1>
			<div class="talk-areas"><Areas areas={t.areas} /></div>
			{abstract && <div set:html={abstract} />}
			{t.links && (
				<ul class="slots">{Object.entries(t.links).map(([k, v]) => <li><a href={urlOf(v)}>{k === 'repo' ? 'Repository' : k.charAt(0).toUpperCase() + k.slice(1)}</a></li>)}</ul>
			)}

			<h2>{t.events.length === 1 ? 'Event' : 'Events'}</h2>
			<ul class="events">
				{t.events.map((e) => (
					<li>
						<time datetime={e.date}>{formatDate(e.date)}</time>
						<div>
							<p>{TALK_TYPES[e.type] ?? e.type}, {e.venue}{place(e) && `, ${place(e)}`}</p>
							{e.title && e.title !== t.title && <p class="event-title">{e.title}</p>}
							{(roleNote(e.roles) || e.coauthors?.length || e.award) && (
								<p class="event-meta">
									{[roleNote(e.roles), e.coauthors?.length ? `with ${e.coauthors.map(fullName).join(', ')}` : '', e.award].filter(Boolean).join(' · ')}
								</p>
							)}
							{e.file && <ul class="slots" aria-label="Materials"><li><a href={url(`/${e.file}`)}>Slides</a></li></ul>}
						</div>
					</li>
				))}
			</ul>

			{related.length > 0 && (
				<>
					<h2>Related publications</h2>
					<div class="pub-list">{related.map((p, k) => <PublicationEntry pub={p} abstract={false} repeatYear={k > 0 && related[k - 1].year === p.year} />)}</div>
				</>
			)}
			{t.license && <p class="license">Slides licensed under {t.license.replace(/-/g, ' ')}.</p>}
		</main>
		<Footer />
	</body>
</html>
