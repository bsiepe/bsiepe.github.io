---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="The page you requested could not be found." />
		<style>
			.lead { margin-bottom: var(--s3); }
			.pages { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Page not found</h1>
			<p class="lead">
				This page does not exist or has moved. Try the search, or one of these pages:
			</p>
			<ul class="pages">
				<li><a href={url('/')}>Home</a></li>
				<li><a href={url('/publications/')}>Publications</a></li>
				<li><a href={url('/talks/')}>Talks</a></li>
				<li><a href={url('/workshops/')}>Workshops</a></li>
				<li><a href={url('/software/')}>Software</a></li>
				<li><a href={url('/blog/')}>Blog</a></li>
				<li><a href={url('/cv/')}>CV</a></li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
