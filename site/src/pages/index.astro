---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { news, publications } from '../lib/data';
import { formatDate } from '../lib/format';
import { md, mdInline } from '../lib/markdown';
import { url } from '../utils/paths';

const bio = await md(PROFILE.bio);
const items = await Promise.all(news().map(async (n) => ({ ...n, html: await mdInline(n.text) })));
const recent = publications().sort((a, b) => b.year - a.year).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				display: grid;
				grid-template-columns: 1fr 220px;
				gap: 3rem;
				align-items: start;
				padding: 1rem 0 2rem;
			}
			.intro h1 { margin-bottom: 0.25rem; }
			.intro .role { margin: 0 0 1.5rem; color: var(--color-text-muted); }
			.intro img { width: 220px; height: 220px; object-fit: cover; border-radius: 50%; }
			.bio :global(p) { color: var(--color-text-main); }
			.news { list-style: none; padding: 0; margin: 0; }
			.news li {
				display: grid;
				grid-template-columns: 7rem 1fr;
				gap: 1rem;
				padding: 0.6rem 0;
				border-bottom: 1px solid var(--color-border);
			}
			.news time { color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
			@media (max-width: 720px) {
				.intro { grid-template-columns: 1fr; }
				.intro img { order: -1; width: 160px; height: 160px; }
				.news li { grid-template-columns: 1fr; gap: 0; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<div>
					<h1>{SITE_TITLE}</h1>
					<p class="role">{PROFILE.position}, {PROFILE.affiliation.institution}</p>
					<div class="bio" set:html={bio} />
				</div>
				<img src={url(`/${PROFILE.photo}`)} alt={`Portrait of ${SITE_TITLE}`} width="220" height="220" />
			</section>

			<section>
				<h2>News</h2>
				<ul class="news">
					{items.map((n) => (
						<li><time datetime={n.date}>{formatDate(n.date)}</time><span set:html={n.html} /></li>
					))}
				</ul>
			</section>

			<section>
				<h2>Recent publications</h2>
				{recent.map((p) => <PublicationEntry pub={p} abstract={false} />)}
				<p><a href={url('/publications/')}>All publications</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
