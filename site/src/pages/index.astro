---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { CONTACT_LINES, EMAIL, PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { news, publications } from '../lib/data';
import { formatDate } from '../lib/format';
import { md, mdInline } from '../lib/markdown';
import { url } from '../utils/paths';

const bio = await md(PROFILE.bio);
const items = await Promise.all(news().map(async (n) => ({ ...n, html: await mdInline(n.text) })));
const selected = publications().filter((p) => p.selected).sort((a, b) => b.year - a.year);
const aff = PROFILE.affiliation;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				display: grid;
				grid-template-columns: minmax(0, 66ch) 240px;
				grid-template-areas: "head head" "bio photo" "bio contact";
				grid-template-rows: auto auto 1fr;
				column-gap: var(--s8);
				justify-content: space-between;
			}
			.intro-head { grid-area: head; }
			.intro h1 { margin-bottom: var(--s1); }
			.role { margin: 0; font-size: 16px; color: var(--color-text-muted); }
			.bio { grid-area: bio; margin-top: var(--s4); }
			.bio :global(p:last-child) { margin-bottom: 0; }
			.photo { grid-area: photo; margin-top: calc(var(--s4) + 6px); }
			.photo img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: 4px; }
			.contact { grid-area: contact; align-self: start; list-style: none; margin: var(--s3) 0 0; padding: 0; font-size: 15px; line-height: 1.6; }
			.contact li + li { margin-top: 4px; }
			.contact a { text-decoration: none; }
			.contact a:hover { text-decoration: underline; }
			.contact .sep { color: var(--color-text-muted); padding: 0 8px; }

			.home-section h2 { margin-top: var(--s12); }
			.news { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); max-width: calc(var(--year-col) + var(--s3) + 76ch); }
			.news li { display: grid; grid-template-columns: var(--year-col) minmax(0, 1fr); column-gap: var(--s3); }
			.news time { font-family: var(--font-serif); font-size: 17px; color: var(--color-text-muted); font-variant-numeric: lining-nums tabular-nums; }

			@media (max-width: 860px) {
				.intro { grid-template-columns: minmax(0, 1fr) min(240px, 30vw); grid-template-areas: "head photo" "bio photo" "bio contact"; column-gap: var(--s4); }
				.photo { margin-top: 0; }
			}
			@media (max-width: 560px) {
				.intro { grid-template-columns: minmax(0, 1fr) 96px; grid-template-areas: "head photo" "bio bio" "contact contact"; grid-template-rows: auto; align-items: end; }
				.contact { margin-top: var(--s4); }
				.home-section h2 { margin-top: var(--s8); }
				.news li { grid-template-columns: 1fr; }
				.news time { font-size: 15px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<section class="intro">
				<div class="intro-head">
					<h1>{SITE_TITLE}</h1>
					<p class="role">{PROFILE.position}, {aff.unit}, {aff.institution}</p>
				</div>
				<div class="bio" set:html={bio} />
				<div class="photo">
					<img src={url(`/${PROFILE.photo}`)} alt={`Portrait of ${SITE_TITLE}`} width="240" height="300" />
				</div>
				<ul class="contact" aria-label="Contact">
					<li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
					{CONTACT_LINES.map((line) => (
						<li>{line.map((l, k) => <>{k > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={l.href}>{l.label}</a></>)}</li>
					))}
				</ul>
			</section>

			<section class="home-section">
				<h2>News</h2>
				<ul class="news">
					{items.map((n) => (
						<li><time datetime={n.date}>{formatDate(n.date)}</time><span set:html={n.html} /></li>
					))}
				</ul>
			</section>

			<section class="home-section">
				<h2>Selected publications</h2>
				<div class="pub-list">
					{selected.map((p, k) => <PublicationEntry pub={p} abstract={false} repeatYear={k > 0 && selected[k - 1].year === p.year} />)}
				</div>
				<p class="after-list"><a href={url('/publications/')}>All publications</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
