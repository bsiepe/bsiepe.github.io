---
// Lecture series page, at its old URL. The .ics next to it is generated by
// ../scripts/export.mjs and copied by scripts/sync-assets.mjs.
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { lectureSeries } from '../../lib/data';
import { formatDate, fullName } from '../../lib/format';
import { md } from '../../lib/markdown';
import { url } from '../../utils/paths';

const s = lectureSeries();
const about = s.about ? await md(s.about) : '';
const ics = url('/simulation-talk-series/Simulation-Lecture-Dates.ics');
const years = [...new Set(s.sessions.map((x) => x.date.slice(0, 4)))].join(', ');
const speakers = (ps: { family: string; given?: string }[]) =>
	ps.length > 1 ? `${ps.slice(0, -1).map(fullName).join(', ')} & ${fullName(ps[ps.length - 1])}` : fullName(ps[0]);
const LINKS = [
	['join', 'Join'],
	['slides', 'Slides'],
	['recording', 'Recording'],
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${s.title} | ${SITE_TITLE}`} description={s.title} />
		<style>
			.facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0 0 1.5rem; }
			.facts dt { font-weight: 700; }
			.facts dd { margin: 0; color: var(--color-text-muted); }
			.schedule { list-style: none; padding: 0; margin: 0; }
			.schedule > li {
				display: grid;
				grid-template-columns: 9.5rem 1fr auto;
				gap: var(--s3);
				padding: var(--s1) 0;
				align-items: baseline;
			}
			.schedule time { white-space: nowrap; font-family: var(--font-serif); font-size: 17px; color: var(--color-text-muted); font-variant-numeric: lining-nums tabular-nums; }
			.schedule .speakers { display: block; font-size: 15px; color: var(--color-text-muted); }
			.schedule .slots { margin: 0; }
			@media (max-width: 720px) {
				.facts { grid-template-columns: 1fr; }
				.facts dd { margin-bottom: 0.5rem; }
				.schedule > li { grid-template-columns: 1fr; gap: 0.2rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-pagefind-body>
			<h1>{s.title}</h1>
			<div class="lead" set:html={about} />
			<dl class="facts">
				{s.schedule && <><dt>Time</dt><dd>{s.schedule}</dd></>}
				{s.organizer && <><dt>Organizer</dt><dd>{s.organizer}</dd></>}
				{s.contact_email && <><dt>Contact</dt><dd><a href={`mailto:${s.contact_email}`}>{s.contact_email}</a></dd></>}
				<dt>Calendar</dt><dd><a href={ics}>Calendar file (.ics) with all sessions</a></dd>
			</dl>

			<h2>Schedule {years}</h2>
			<ul class="schedule">
				{s.sessions.map((x) => (
					<li>
						<time datetime={`${x.date}T${x.time}`}>{formatDate(x.date)}, {x.time}</time>
						<span>
							{x.title}
							<span class="speakers">{speakers(x.speakers)}</span>
						</span>
						<ul class="slots">
							{LINKS.map(([k, label]) => (
								<li>{x.links?.[k] ? <a href={x.links[k]}>{label}</a> : <span class="missing">{label}</span>}</li>
							))}
						</ul>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
