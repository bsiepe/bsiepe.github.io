{
  "name": "bsiepe-site",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs && node scripts/thumbnails.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/check-urls.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check-urls": "node scripts/check-urls.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.5.0",
    "pagefind": "^1.4.0"
  },
  "private": true,
  "description": "Website. Based on astro-scholar (MIT, see LICENSE); reads ../data and ../content.",
  "overrides": {
    "katex": "$katex"
  }
}
